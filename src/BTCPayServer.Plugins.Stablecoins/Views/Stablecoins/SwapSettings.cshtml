@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.Stablecoins.Controllers
@using BTCPayServer.Plugins.Stablecoins.Swap
@model SwapSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("STABLECOINS-SWAP", "Pay from other chains"));
    Layout = "_Layout";
    var storeId = Context.GetRouteValue("storeId");
}

<partial name="_StatusMessage" />

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <p class="text-secondary">
            Each chain below becomes its own payment method, so WooCommerce can list it as a separate option.
            Invoices are priced and settled in BTC: the customer's coins are swapped to native BTC and paid to a fresh address
            from this store's BTC wallet. BTCPay never holds the customer's coins.
            In WooCommerce (BTCPay plugin, "Separate payment gateways"), each enabled chain shows up as its own gateway named by
            the code next to it. Rename it there, for example to "Ethereum".
        </p>
        @if (!Model.HasBtcWallet)
        {
            <div class="alert alert-warning" role="alert">
                This store has no BTC on-chain wallet yet. <a asp-controller="UIStores" asp-action="SetupWallet" asp-route-storeId="@storeId" asp-route-cryptoCode="BTC">Set one up</a> first: the swapped BTC is paid into it.
            </div>
        }
        @if (!ViewContext.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="text-danger"></div>
        }
        @* novalidate: the server checks every field and says what is wrong; the browser's own checks can block Save without a visible reason. *@
        <form method="post" asp-action="SwapSettings" asp-route-storeId="@storeId" novalidate>
            <h4 class="mt-4 mb-2">Tokens, through LI.FI</h4>
            <p class="text-secondary">
                The customer connects their wallet and pays with any token on the chain; <a href="https://li.fi" target="_blank" rel="noreferrer noopener">LI.FI</a>
                routes it through a bridge that pays BTC.
            </p>
            <div class="form-group">
                @for (var i = 0; i < Model.Chains.Count; i++)
                {
                    if (Model.Chains[i].Provider != SwapProvider.Lifi) continue;
                    <partial name="/Views/Stablecoins/_SwapChainToggle.cshtml" model="(Model, i)" />
                }
            </div>
            <div class="form-group">
                <label asp-for="Integrator" class="form-label"></label>
                <input asp-for="Integrator" class="form-control" autocomplete="off" spellcheck="false" required maxlength="64" />
                <span asp-validation-for="Integrator" class="text-danger"></span>
                <div class="form-text">The integration name from <a href="https://portal.li.fi" target="_blank" rel="noreferrer noopener">portal.li.fi</a>.</div>
            </div>
            <div class="form-group">
                <label asp-for="ApiKey" class="form-label"></label>
                <input asp-for="ApiKey" class="form-control font-monospace" autocomplete="off" spellcheck="false" />
                <div class="form-text">Raises LI.FI's rate limits. It is visible in the checkout page's source, as LI.FI's widget requires.</div>
            </div>
            <div class="form-group">
                <label asp-for="WalletConnectProjectId" class="form-label"></label>
                <input asp-for="WalletConnectProjectId" class="form-control font-monospace" autocomplete="off" spellcheck="false" />
                <div class="form-text">From <a href="https://cloud.reown.com" target="_blank" rel="noreferrer noopener">Reown</a>. Lets customers connect mobile EVM wallets by QR code. Browser wallets work without it.</div>
            </div>
            <div class="form-group">
                <label asp-for="FeePercent" class="form-label"></label>
                <input asp-for="FeePercent" type="number" min="0" max="9.99" step="0.01" class="form-control" />
                <span asp-validation-for="FeePercent" class="text-danger"></span>
                <div class="form-text">0 charges the customer nothing extra. Above 0, it is added to the swap and paid to your LI.FI fee wallets.</div>
            </div>

            <h4 class="mt-5 mb-2">Native coins, through THORChain</h4>
            <p class="text-secondary">
                The customer sends the coin from their own wallet to a <a href="https://thorchain.org" target="_blank" rel="noreferrer noopener">THORChain</a> vault with a memo that names
                the invoice's BTC address. Their wallet must be able to add that memo.
            </p>
            <div class="form-group">
                @for (var i = 0; i < Model.Chains.Count; i++)
                {
                    if (Model.Chains[i].Provider != SwapProvider.Thorchain) continue;
                    <partial name="/Views/Stablecoins/_SwapChainToggle.cshtml" model="(Model, i)" />
                }
            </div>
            <div class="form-group">
                <label asp-for="ThornodeUrl" class="form-label"></label>
                <input asp-for="ThornodeUrl" class="form-control font-monospace" autocomplete="off" spellcheck="false" placeholder="@BTCPayServer.Plugins.Stablecoins.Thorchain.ThornodeClient.DefaultUrl" />
                <span asp-validation-for="ThornodeUrl" class="text-danger"></span>
                <div class="form-text">Where BTCPay asks THORChain for quotes. Leave empty for the public gateway.</div>
            </div>
            <div class="form-group">
                <label asp-for="ThorToleranceBps" class="form-label"></label>
                <input asp-for="ThorToleranceBps" type="number" min="10" max="5000" step="1" class="form-control" />
                <span asp-validation-for="ThorToleranceBps" class="text-danger"></span>
                <div class="form-text">If the price moves more than this before the swap runs, THORChain refunds the customer instead. 300 = 3%.</div>
            </div>
            <div class="form-group">
                <label asp-for="ThorAffiliate" class="form-label"></label>
                <input asp-for="ThorAffiliate" class="form-control" autocomplete="off" spellcheck="false" maxlength="30" />
                <span asp-validation-for="ThorAffiliate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThorAffiliateBps" class="form-label"></label>
                <input asp-for="ThorAffiliateBps" type="number" min="0" max="1000" step="1" class="form-control" />
                <span asp-validation-for="ThorAffiliateBps" class="text-danger"></span>
                <div class="form-text">0 charges the customer nothing extra.</div>
            </div>

            <h4 class="mt-5 mb-2">Both</h4>
            <div class="form-group">
                <label asp-for="BufferPercent" class="form-label"></label>
                <input asp-for="BufferPercent" type="number" min="0" max="5" step="0.1" class="form-control" />
                <span asp-validation-for="BufferPercent" class="text-danger"></span>
                <div class="form-text">Asks for this much more BTC than is due, paid by the customer. Leave at 0 and use the store's payment tolerance instead to absorb small shortfalls yourself.</div>
            </div>

            <div class="alert alert-info" role="note">
                Swaps to BTC usually take several minutes and can take longer. Give invoices enough time
                (Store settings → Checkout → invoice expiry, for example 60 minutes), and set a payment tolerance of about 1%
                (Store settings → Payment) so a swap that lands a few satoshis short still completes the order.
            </div>

            <button type="submit" class="btn btn-primary" id="Save">Save</button>
        </form>
    </div>
</div>
