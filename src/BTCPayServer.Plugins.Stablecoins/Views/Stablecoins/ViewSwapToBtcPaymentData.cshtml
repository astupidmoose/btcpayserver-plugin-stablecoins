@using BTCPayServer.Payments
@using BTCPayServer.Plugins.Stablecoins.Swap
@using BTCPayServer.Services
@using BTCPayServer.Services.Invoices
@inject DisplayFormatter DisplayFormatter
@inject TransactionLinkProviders TransactionLinkProviders
@inject PaymentMethodHandlerDictionary Handlers
@model BTCPayServer.Models.InvoicingModels.InvoiceDetailsModel
@{
    var payments = Model.Payments
        .Where(p => SwapSourceChain.Find(p.PaymentMethodId) is not null && Handlers.Support(p.PaymentMethodId))
        .Select(p =>
        {
            var handler = (SwapToBtcPaymentMethodHandler)Handlers[p.PaymentMethodId];
            var data = handler.ParsePaymentDetails(p.Details);
            return new
            {
                Payment = p,
                Chain = handler.Chain,
                Data = data,
                Link = data.PendingOrder is null ? TransactionLinkProviders.GetTransactionLink(p.PaymentMethodId, data.Outpoint) : null
            };
        }).ToList();
}
@if (payments.Any())
{
    <section>
        <h5>BTC received from swaps</h5>
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Paid from</th>
                <th>BTC transaction</th>
                <th>Confirmations</th>
                <th class="text-end">Received</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in payments)
            {
                @* Struck out like BTCPay's own on-chain payments when the transaction was replaced: it no longer counts. *@
                <tr style="@(p.Payment.Accounted ? "" : "text-decoration: line-through")"
                    title="@(p.Payment.Accounted ? null : p.Data.PendingOrder is null ? "Replaced: not counted" : "No longer counted: the BTC arrived, or the swap did not complete")">
                    <td>
                        @p.Chain.Name
                    </td>
                    @if (p.Data.PendingOrder is { } order)
                    {
                        <td>Pending, Pegasus Swap order @order</td>
                    }
                    else
                    {
                        <td><vc:truncate-center text="@p.Data.Outpoint" link="@p.Link" classes="truncate-center-id" /></td>
                    }
                    <td>@p.Data.ConfirmationCount</td>
                    <td class="payment-value text-end text-nowrap">
                        <span data-sensitive class="text-success">@DisplayFormatter.Currency(p.Payment.Value, p.Payment.Currency)</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
