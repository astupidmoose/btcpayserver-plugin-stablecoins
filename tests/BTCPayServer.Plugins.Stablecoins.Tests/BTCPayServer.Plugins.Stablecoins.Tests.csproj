<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Same xUnit analyzer exceptions as BTCPay's own tests. -->
    <NoWarn>$(NoWarn),xUnit1031,xUnit1051,xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same xUnit as the pinned BTCPay tests. Referenced directly: BTCPay's whole test project (and Playwright)
         was only ever pulled in for it, and dominated the build. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.Stablecoins\BTCPayServer.Plugins.Stablecoins.csproj" />
    <ProjectReference Include="..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
  </ItemGroup>

  <!-- This will make sure that referencing BTCPayServer doesn't put any artifact in the published directory -->
  <ItemDefinitionGroup>
      <ProjectReference>
          <Properties>StaticWebAssetsEnabled=false</Properties>
      </ProjectReference>
  </ItemDefinitionGroup>
</Project>